# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored; never commit real credentials.

# --- General -----------------------------------------------------------------
PROJECT_NAME=Mensch Multiplayer Game
# Debug mode mounts the /api/dev cheat endpoints (arbitrary piece placement) and
# enables FastAPI's debug pages. Keep this `false` outside local development.
DEBUG=false

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Game rules --------------------------------------------------------------
# Seconds a player may stay disconnected before forfeiting the match.
DISCONNECT_TIMEOUT=60
# Seconds a player may wait in the matchmaking queue before timing out.
MATCHMAKING_TIMEOUT=30

# --- Porteghal integration ---------------------------------------------------
PORTEGHAL_API_URL=http://localhost:8090
# Required. The service refuses to call the Porteghal internal API without it.
# Obtain the key from the Porteghal admin panel; never hard-code it in source.
PORTEGHAL_API_KEY=

# --- Player authentication ---------------------------------------------------
# HMAC secret used to sign the short-lived player tokens the WebView presents on
# every socket. Empty falls back to PORTEGHAL_API_KEY. Production refuses to mint
# or verify tokens when neither is set; DEBUG=true is the only exception.
GAME_TOKEN_SECRET=

# --- CORS --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Empty means
# same-origin only, which is what the reverse proxied deployment needs. `*` is
# accepted only when DEBUG=true.
ALLOWED_CORS_ORIGINS=http://localhost:3000
