# Frontend build-time configuration (copy to .env for local development).
#
# Backend origins. Leave both empty in production when the same reverse proxy
# serves the built app and forwards /api and /ws to the backend; the client
# then uses its own origin. Set them when the API lives on another origin.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
#
# Dev server host check (comma separated, e.g. game.example.com). Empty keeps
# the check disabled for local development only.
VITE_ALLOWED_HOSTS=
